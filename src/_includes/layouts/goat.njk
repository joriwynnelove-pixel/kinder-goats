---
layout: layouts/base.njk
---
{% import "partials/cards.njk" as cards with context %}
{% set g = goatGraph.goats[id] %}

<article class="goat">

  {# 1. Name, nickname, status, price #}
  <header class="goat-head">
    <h1>{{ name }}</h1>
    {% if nickname %}<p class="nickname">“{{ nickname }}”</p>{% endif %}
    <p class="goat-status">
      {% if status and status != "retained" %}
        <span class="badge badge-{{ status }}">{{ status | statusLabel }}</span>
      {% endif %}
      {% if status == "for-sale" %}{% if site.show_prices and price %}<span class="price">{{ price }}</span>{% elif not site.show_prices %}<span class="price price-inquire">Inquire for price</span>{% endif %}{% endif %}
    </p>
    {% if status == "reference" %}
      <p class="muted">Not part of our herd. Listed here for pedigree reference.</p>
    {% endif %}
  </header>

  <div class="goat-top">
    {# 2. Photos: swipe sideways through them (works without JavaScript);
          tap one to open it full screen (js/gallery.js). #}
    <section class="gallery" aria-label="Photos of {{ nickname or name }}" data-gallery>
      {% if gallery and gallery.length %}
        <div class="gallery-track" tabindex="0">
          {% for p in gallery %}
            {% set alt = (p.caption or (nickname or name)) + (", " + (p.date | readableDate) if p.date else "") %}
            <figure class="slide" id="photo-{{ loop.index }}">
              <a class="slide-link" href="{{ p.img.large }}" data-index="{{ loop.index0 }}">
                <picture>
                  <source type="image/webp" srcset="{{ p.img.webp }}" sizes="(min-width: 1040px) 600px, (min-width: 760px) 58vw, 100vw">
                  <img eleventy:ignore src="{{ p.img.src }}" srcset="{{ p.img.jpeg }}" sizes="(min-width: 1040px) 600px, (min-width: 760px) 58vw, 100vw"
                       width="{{ p.img.width }}" height="{{ p.img.height }}" alt="{{ name }}: {{ alt }}"
                       {% if not loop.first %}loading="lazy"{% endif %} decoding="async">
                </picture>
              </a>
              <figcaption>
                {% if gallery.length > 1 %}<span class="slide-count">{{ loop.index }} / {{ gallery.length }}</span>{% endif %}
                {{ p.caption }}
                {% if p.date %}<span class="muted">· {{ p.date | readableDate }}{% if birth_date %} (age {{ birth_date | ageAt(p.date) }}){% endif %}</span>{% endif %}
              </figcaption>
            </figure>
          {% endfor %}
        </div>
        {% if gallery.length > 1 %}
          <nav class="gallery-thumbs" aria-label="Choose a photo">
            {% for p in gallery %}
              <a href="#photo-{{ loop.index }}" data-index="{{ loop.index0 }}"{% if loop.first %} aria-current="true"{% endif %}>
                <img eleventy:ignore src="{{ p.img.thumb }}" alt="Photo {{ loop.index }}" loading="lazy" width="80" height="60">
              </a>
            {% endfor %}
          </nav>
        {% endif %}
      {% else %}
        <div class="photo photo-main photo-none">No photos yet</div>
      {% endif %}
    </section>

    {# 3. Quick facts #}
    <section class="facts" aria-labelledby="facts-h">
      <h2 id="facts-h">Quick facts</h2>
      <dl>
        <dt>Sex</dt><dd>{{ sex | capitalize }}</dd>
        {% if birth_date %}<dt>Born</dt><dd>{{ birth_date | readableDate }} <span class="muted">({{ birth_date | age }})</span></dd>{% endif %}
        {% if registration_number %}<dt>Registration</dt><dd>{{ site.registry_name }} {{ registration_number }}</dd>{% endif %}
        {% if tattoo %}<dt>Tattoo</dt><dd>{{ tattoo }}</dd>{% endif %}
        {% if color %}<dt>Color</dt><dd>{{ color }}</dd>{% endif %}
        {% if horn_status %}<dt>Horns</dt><dd>{{ horn_status | capitalize }}</dd>{% endif %}
        {% set breederName = breeder or (site.farm_name if status != "reference") %}
        {% if breederName %}<dt>Breeder</dt><dd>{{ breederName }}</dd>{% endif %}
        {% if owner %}<dt>Owner</dt><dd>{{ owner }}</dd>{% endif %}
      </dl>
      {% if pedigree_url %}
        <a class="button" href="{{ pedigree_url }}" target="_blank" rel="noopener">View {{ site.registry_name }} pedigree ↗</a>
      {% elif site.registry_search_url %}
        <a class="text-link" href="{{ site.registry_search_url }}" target="_blank" rel="noopener">Search {{ site.registry_name }} pedigrees ↗</a>
      {% endif %}
      {% if status != "reference" %}
        {# Shown by the small script at the end of this page; without JavaScript the browser Print menu gives the same sheet #}
        <p class="no-print"><button type="button" class="text-button" data-print hidden>Print sale sheet</button></p>
      {% endif %}
    </section>
  </div>

  {# 4. Description (the Markdown body of the goat file) #}
  {% if content | trim %}
    <section class="description">
      <h2>About {{ nickname or name }}</h2>
      {{ content | safe }}
    </section>
  {% endif %}

  {# Videos: links to YouTube or Vimeo, shown as tap-to-play previews #}
  {% if videos and videos.length %}
    <section class="videos" aria-labelledby="videos-h">
      <h2 id="videos-h">Videos</h2>
      <div class="video-grid">
        {% for v in videos %}{% set vi = v.url | videoInfo %}
          <figure class="video">
            <a class="video-link video-{{ vi.kind }}" href="{{ vi.url }}" target="_blank" rel="noopener"{% if vi.embed %} data-embed="{{ vi.embed }}"{% endif %}>
              {% if vi.thumb %}<img eleventy:ignore src="{{ vi.thumb }}" alt="" loading="lazy">{% endif %}
              <span class="play" aria-hidden="true">▶</span>
              <span class="visually-hidden">Play video: {{ v.caption or name }}</span>
            </a>
            {% if v.caption or v.date %}
              <figcaption>{{ v.caption }}{% if v.date %} <span class="muted">· {{ v.date | readableDate }}{% if birth_date %} (age {{ birth_date | ageAt(v.date) }}){% endif %}</span>{% endif %}</figcaption>
            {% endif %}
          </figure>
        {% endfor %}
      </div>
    </section>
    <script src="/js/video.js" defer></script>
  {% endif %}

  {# 5. Records, each only if it has data #}
  {% if milk_records and milk_records.length %}
    <section class="records">
      <h2>Milk records</h2>
      <div class="table-scroll"><table>
        <thead><tr><th>Date</th><th>Days in milk</th><th>Milk (lbs)</th><th>Butterfat %</th><th>Protein %</th></tr></thead>
        <tbody>
        {% for r in milk_records %}
          <tr><td>{{ r.date | readableDate }}</td><td>{{ r.days_in_milk }}</td><td>{{ r.lbs }}</td><td>{{ r.butterfat }}</td><td>{{ r.protein }}</td></tr>
        {% endfor %}
        </tbody>
      </table></div>
    </section>
  {% endif %}

  {% if evaluations and evaluations.length %}
    <section class="records">
      <h2>Evaluations and show results</h2>
      <div class="table-scroll"><table>
        <thead><tr><th>Date</th><th>Type</th><th>Score or placing</th><th>Notes</th></tr></thead>
        <tbody>
        {% for r in evaluations %}
          <tr><td>{{ r.date | readableDate }}</td><td>{{ r.type }}</td><td>{{ r.score }}</td><td>{{ r.notes }}</td></tr>
        {% endfor %}
        </tbody>
      </table></div>
    </section>
  {% endif %}

  {# Health tests: this goat's own, plus whole-herd tests from settings (not shown for outside goats) #}
  {% set herdTests = site.herd_health_tests if status != "reference" else [] %}
  {% if (health_tests and health_tests.length) or (herdTests and herdTests.length) %}
    <section class="records">
      <h2>Health tests</h2>
      {% if health_tests and health_tests.length %}
        <div class="table-scroll"><table>
          <thead><tr><th>Date</th><th>Test</th><th>Result</th><th>Lab report</th></tr></thead>
          <tbody>
          {% for r in health_tests %}
            <tr><td>{{ r.date | readableDate }}</td><td>{{ r.test }}{% if r.lab %}<br><span class="muted">{{ r.lab }}</span>{% endif %}</td><td>{{ r.result }}</td><td>{{ cards.reportLink(r.report, r.test + " report for " + name) }}</td></tr>
          {% endfor %}
          </tbody>
        </table></div>
      {% endif %}
      {% if herdTests and herdTests.length %}
        <h3 class="small-heading">Whole-herd testing</h3>
        <div class="table-scroll"><table>
          <thead><tr><th>Date</th><th>Test</th><th>Result</th><th>Lab report</th></tr></thead>
          <tbody>
          {% for r in herdTests %}
            <tr><td>{{ r.date | readableDate }}</td><td>{{ r.test }}{% if r.lab %}<br><span class="muted">{{ r.lab }}</span>{% endif %}</td><td>{{ r.result }}</td><td>{{ cards.reportLink(r.report, r.test + " herd report") }}</td></tr>
          {% endfor %}
          </tbody>
        </table></div>
      {% endif %}
      <p class="muted small">Tap a report to open it full size.</p>
    </section>
  {% endif %}

  {% if kidding_history and kidding_history.length %}
    <section class="records">
      <h2>Kidding history</h2>
      <div class="table-scroll"><table>
        <thead><tr><th>Date</th><th>Kids</th><th>Notes</th></tr></thead>
        <tbody>
        {% for r in kidding_history %}
          <tr><td>{{ r.date | readableDate }}</td><td>{{ r.kids }}</td><td>{{ r.notes }}</td></tr>
        {% endfor %}
        </tbody>
      </table></div>
    </section>
  {% endif %}

  {# 6–7. Parents and grandparents #}
  <section class="family" aria-labelledby="parents-h">
    <h2 id="parents-h">Parents</h2>
    <div class="parents">
      {{ cards.parentCard("Dam", g.dam, goatGraph.goats, site) }}
      {{ cards.parentCard("Sire", g.sire, goatGraph.goats, site) }}
    </div>
    {% set gp = g.grandparents %}
    {% if gp.damDam or gp.damSire or gp.sireDam or gp.sireSire %}
      <h3 class="small-heading">Grandparents</h3>
      <ul class="ancestors">
        {{ cards.ancestor("Dam's dam", gp.damDam) }}
        {{ cards.ancestor("Dam's sire", gp.damSire) }}
        {{ cards.ancestor("Sire's dam", gp.sireDam) }}
        {{ cards.ancestor("Sire's sire", gp.sireSire) }}
      </ul>
    {% endif %}

    {% if g.siblings.length %}
      <h3 class="small-heading siblings-heading">Full siblings</h3>
      <ul class="sibling-list">
        {% for sid in g.siblings %}{% set s = goatGraph.goats[sid] %}
          <li><a href="/goats/{{ s.id }}/">{{ s.nickname or s.name }}</a> <span class="muted">({{ s.sex }}{% if s.birth_date %}, {{ s.birth_date | year }}{% endif %})</span></li>
        {% endfor %}
      </ul>
    {% endif %}
  </section>

  {# 8. Offspring, built automatically #}
  {% if g.offspring.length %}
    <section class="offspring" aria-labelledby="offspring-h">
      <h2 id="offspring-h">Offspring <span class="muted">({{ g.offspring.length }})</span></h2>
      <div class="grid">
        {% for kidId in g.offspring %}
          {{ cards.goatCard(goatGraph.goats[kidId]) }}
        {% endfor %}
      </div>
    </section>
  {% endif %}

  {# Blog posts that tag this goat #}
  {% set mentions = collections.posts | postsAboutGoat(id) %}
  {% if mentions.length %}
    <section class="mentions" aria-labelledby="mentions-h">
      <h2 id="mentions-h">Mentioned in the blog</h2>
      <ul class="mention-list">
        {% for post in mentions %}<li><a href="{{ post.url }}">{{ post.data.title }}</a> <span class="muted">· {{ post.date | readableDate }}</span></li>{% endfor %}
      </ul>
    </section>
  {% endif %}

  {# Facebook / Instagram / Threads posts about this goat (public posts, no login needed) #}
  {% if social_posts | hasItems %}
    <section class="social-posts" aria-labelledby="social-h">
      <h2 id="social-h">On social media</h2>
      {% set embedList = social_posts %}
      {% include "partials/social-embeds.njk" %}
    </section>
  {% endif %}

  {# 9. Contact. For sale or reserved: ask about this goat (reserved goats collect
     backup buyers). Otherwise: ask about its future kids.
     No button for outside (reference), sold or deceased goats, or for wethers
     that aren't for sale, since none of them will have kids here. #}
  {% set short = nickname or name %}
  {% if status == "for-sale" %}
    <section class="contact-cta">
      <h2>Interested in {{ short }}?</h2>
      <a class="button" href="/contact/?goat={{ name | urlencode }}&amp;subject={{ ('Question about ' + name) | urlencode }}">Ask about {{ short }}</a>
    </section>
  {% elif status == "reserved" %}
    <section class="contact-cta">
      <h2>Interested in {{ short }}?</h2>
      <p class="muted">{{ short }} is reserved, but sales sometimes fall through. Ask to be the backup buyer.</p>
      <a class="button" href="/contact/?goat={{ name | urlencode }}&amp;subject={{ ('Backup buyer for ' + name) | urlencode }}">Ask about {{ short }}</a>
    </section>
  {% elif status not in ["reference", "sold", "deceased"] and sex != "wether" %}
    <section class="contact-cta">
      <h2>Interested in {{ short | possessive }} kids?</h2>
      <p class="muted">{{ short }} isn't for sale, but you can ask about upcoming kids.</p>
      <a class="button" href="/contact/?goat={{ ('Kids from ' + name) | urlencode }}&amp;subject={{ ('Kids from ' + name) | urlencode }}">Ask about {{ short | possessive }} kids</a>
    </section>
  {% endif %}

  {# Only on paper: QR code and contact details for the printed sale sheet #}
  {% if status != "reference" %}
    <aside class="print-only sheet-footer">
      {% if qrSvg %}<div class="qr">{{ qrSvg | safe }}</div>{% endif %}
      <div>
        <p><strong>Scan for more photos, records and family.</strong></p>
        {% if pageUrl %}<p class="sheet-url">{{ pageUrl }}</p>{% endif %}
        <p>{{ site.farm_name }} · {{ site.location }} · {{ site.contact_email }}</p>
      </div>
    </aside>
  {% endif %}
</article>
<script src="/js/gallery.js" defer></script>
<script>
  // Show the "Print sale sheet" button only when JavaScript can run it
  document.querySelectorAll("[data-print]").forEach((b) => {
    b.hidden = false;
    b.addEventListener("click", () => window.print());
  });
</script>
